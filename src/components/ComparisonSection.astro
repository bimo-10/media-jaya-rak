---
const rows = [
	{
		label: "Daya Tahan Beban",
		basic: "Cukup, mudah melengkung",
		mjr: "Sangat Kuat & Kokoh",
	},
	{
		label: "Finishing Permukaan",
		basic: "Cat semprot biasa (mudah terkelupas)",
		mjr: "Powder Coating (Anti Karat)",
	},
	{
		label: "Estetika & Rapi",
		basic: "Standar, sambungan kasar",
		mjr: "Presisi & Modern",
	},
	{
		label: "Investasi Jangka Panjang",
		basic: "Sering ganti (Boros)",
		mjr: "Tahan Bertahun-tahun (Hemat)",
	},
	{
		label: "After Sales Service",
		basic: "Jarang ada",
		mjr: "Garansi & Dukungan Penuh",
	},
];
---

<section class="bg-secondary/40 py-16">
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				Kenapa Memilih Media Jaya Rak?
			</h2>
			<p class="mt-3 text-muted-foreground">
				Bandingkan sendiri kualitas dan investasi jangka panjangnya.
			</p>
		</div>

		<div class="mt-10 overflow-x-auto rounded-xl border border-border/70 bg-white shadow-sm">
			<table class="w-full min-w-140 border-collapse text-sm">
				<thead>
					<tr class="border-b border-border/70 bg-secondary/60 text-left">
						<th class="p-4 font-semibold text-foreground">Kriteria</th>
						<th class="p-4 font-semibold text-muted-foreground">Rak Biasa</th>
						<th class="p-4 font-semibold text-primary">Media Jaya Rak</th>
					</tr>
				</thead>
				<tbody>
					{rows.map((row) => (
						<tr class="border-b border-border/70 last:border-b-0">
							<td class="p-4 font-medium text-foreground">{row.label}</td>
							<td class="p-4 text-muted-foreground">{row.basic}</td>
							<td class="p-4 font-medium text-primary">{row.mjr}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</section>
