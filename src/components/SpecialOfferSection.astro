---
import { buttonVariants } from "@/components/ui/button";
import { WA_LINK } from "@/lib/constants";

const perks = [
	{ label: "Rak Gondola / Gudang Pilihan", value: "Sesuai Paket" },
	{ label: "Bonus: Free Pricecard", value: "Gratis" },
	{ label: "Bonus: Free Stopper", value: "Gratis" },
	{ label: "Gratis Ongkir (Wilayah Jawa)", value: "Gratis" },
	{ label: "Subsidi Ongkir (Luar Jawa)", value: "Termurah" },
	{ label: "Gratis Perakitan", value: "Gratis" },
	{ label: "Custom Sesuai Kebutuhan", value: "Gratis" },
	{ label: "Kapasitas Lebih Besar (Hingga 50kg per Susun)", value: "Termurah" },
];
---

<section class="bg-primary/5 py-16">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				Penawaran Spesial Hari Ini
			</h2>
			<p class="mt-3 text-muted-foreground">
				Dapatkan tambahan value untuk pembelian rak premium Anda.
			</p>
		</div>

		<div class="mt-10 rounded-xl border border-primary/30 bg-white shadow-sm">
			<ul class="divide-y divide-border/70">
				{perks.map((perk) => (
					<li class="flex items-center justify-between gap-4 px-6 py-3.5">
						<span class="text-sm font-medium text-foreground">{perk.label}</span>
						<span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary">
							{perk.value}
						</span>
					</li>
				))}
			</ul>
			<div class="p-6 pt-2">
				<a
					href={WA_LINK}
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ size: "lg", className: "w-full" })}
				>
					Ambil Promo Sekarang
				</a>
			</div>
		</div>
	</div>
</section>
