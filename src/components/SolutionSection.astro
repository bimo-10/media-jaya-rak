---
const features = [
	{
		title: "Material Berkualitas Tinggi",
		description:
			"Menggunakan besi hollow tebal yang mampu menahan beban berat tanpa melengkung.",
	},
	{
		title: "Lapisan Powder Coating",
		description:
			"Teknik pengecatan modern yang anti karat, tahan gores, dan warna lebih awet.",
	},
	{
		title: "Desain Modular",
		description:
			"Sambungan shelving yang fleksibel, bisa disesuaikan tinggi rendahnya sesuai kebutuhan produk.",
	},
];
---

<section class="bg-secondary/40 py-16">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				Solusi Terbaik: Media Jaya Rak
			</h2>
			<p class="mt-3 text-muted-foreground">
				Kami menyediakan solusi rak modern yang dirancang tidak hanya untuk
				menyimpan, tetapi juga meningkatkan nilai estetika dan fungsi ruang Anda.
			</p>
		</div>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{features.map((feature, index) => (
				<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-sm font-bold text-primary">
						{index + 1}
					</span>
					<h3 class="mt-4 font-semibold text-foreground">{feature.title}</h3>
					<p class="mt-2 text-sm text-muted-foreground">{feature.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
