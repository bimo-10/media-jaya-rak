---
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";
import { WA_LINK } from "@/lib/constants";
import { Warehouse } from "lucide-react";
import { getHeroImage } from "@/lib/heroImages";

const heroImage = await getHeroImage();

const badges = ["Material Tebal", "Anti Karat", "Kokoh"];
---

<section class="relative overflow-hidden bg-linear-to-b from-orange-50 via-white to-white">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-2 lg:items-center lg:px-8">
		<div class="text-center lg:text-left">
			<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
				SOLUSI RAK GUDANG & TOKO
			</span>

			<h1 class="mt-5 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl">
				Solusi Rak Minimarket &amp; Rak Gudang Terbaik
			</h1>

			<p class="mx-auto mt-5 max-w-xl text-base text-muted-foreground sm:text-lg lg:mx-0">
				Tingkatkan estetika toko dan efisiensi gudang Anda dengan rak berkualitas
				tinggi. Harga bersahabat, pembuatan presisi, dan material besi tebal.
			</p>

			<div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
				<a
					href={WA_LINK}
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ size: "lg" })}
				>
					Konsultasi Gratis
				</a>
				<span class="text-xs text-muted-foreground">*Pengiriman ke seluruh Indonesia</span>
			</div>

			<div class="mt-10 flex flex-wrap justify-center gap-3 lg:justify-start">
				{badges.map((badge) => (
					<span class="rounded-full border border-border bg-white px-4 py-1.5 text-xs font-semibold text-foreground shadow-sm">
						{badge}
					</span>
				))}
			</div>
		</div>

		<div class="relative flex mx-auto aspect-square w-full max-w-md items-center justify-center">
			<Image
				src={heroImage.src}
				alt={heroImage.alt}
				width={heroImage.width}
				height={heroImage.height}
				class="relative z-10 rounded-3xl object-cover "
			/>
		</div>
	</div>
</section>
