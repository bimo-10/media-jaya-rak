---
import type { ComponentType } from "react";

interface Item {
	title: string;
	description: string;
	Icon: ComponentType<{ className?: string; strokeWidth?: number }>;
}

interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	items: Item[];
	columns?: 2 | 4;
	muted?: boolean;
}

const { eyebrow, title, description, items, columns = 2, muted = false } = Astro.props;

const gridClass = columns === 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-2";
---

<section class={muted ? "bg-secondary/40 py-16" : "py-16"}>
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			{eyebrow && (
				<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
					{eyebrow}
				</span>
			)}
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				{title}
			</h2>
			{description && <p class="mt-3 text-muted-foreground">{description}</p>}
		</div>

		<div class={`mt-10 grid gap-6 ${gridClass}`}>
			{items.map(({ title: itemTitle, description: itemDescription, Icon }) => (
				<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<Icon className="size-5" strokeWidth={1.75} />
					</span>
					<h3 class="mt-4 font-semibold text-foreground">{itemTitle}</h3>
					<p class="mt-2 text-sm text-muted-foreground">{itemDescription}</p>
				</div>
			))}
		</div>
	</div>
</section>
