---
import { Star } from "lucide-react";

interface Testimonial {
	name: string;
	business: string;
	quote: string;
	rating?: number;
}

interface Props {
	title: string;
	description?: string;
	testimonials: Testimonial[];
}

const { title, description, testimonials } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{title}</h2>
		{description && <p class="mt-3 text-muted-foreground">{description}</p>}
	</div>

	<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{testimonials.map((testimonial: Testimonial) => (
			<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
				<div class="flex gap-0.5 text-primary">
					{Array.from({ length: testimonial.rating ?? 5 }).map(() => (
						<Star className="size-4 fill-current" strokeWidth={0} />
					))}
				</div>
				<p class="mt-3 text-sm text-muted-foreground">&ldquo;{testimonial.quote}&rdquo;</p>
				<div class="mt-4 flex items-center gap-3">
					<span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
						{testimonial.name.charAt(0)}
					</span>
					<div>
						<p class="text-sm font-semibold text-foreground">{testimonial.name}</p>
						<p class="text-xs text-muted-foreground">{testimonial.business}</p>
					</div>
				</div>
			</div>
		))}
	</div>
</section>
