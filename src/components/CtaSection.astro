---
import { buttonVariants } from "@/components/ui/button";
import { WA_LINK } from "@/lib/constants";

interface Props {
	title: string;
	description: string;
	ctaLabel?: string;
}

const { title, description, ctaLabel = "Chat via WhatsApp Sekarang" } = Astro.props;
---

<section class="bg-primary/5 py-16">
	<div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
		<h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{title}</h2>
		<p class="mt-3 text-muted-foreground">{description}</p>
		<div class="mt-8">
			<a href={WA_LINK} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: "lg" })}>
				{ctaLabel}
			</a>
		</div>
	</div>
</section>
