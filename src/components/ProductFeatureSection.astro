---
import type { ComponentType } from "react";
import { getProdukImage } from "@/lib/produkImages";
import { Image } from "astro:assets";
import { buttonVariants } from "@/components/ui/button";

const produkImages = await Promise.all([4, 1].map(getProdukImage));

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	features: string[];
	imageLabel: string;
	Icon: ComponentType<{ className?: string; strokeWidth?: number }>;
	reverse?: boolean;
	href?: string;
	ctaLabel?: string;
}

const {
	eyebrow,
	title,
	description,
	features,
	imageLabel,
	Icon,
	reverse = false,
	href,
	ctaLabel = "Lihat Detail",
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
	<div
		class:list={[
			"grid items-center gap-10 lg:grid-cols-2",
			{ "lg:[&>*:first-child]:order-2": reverse },
		]}
	>
		<div class="relative mx-auto aspect-4/3 w-full max-w-lg">
			<!-- <div class="absolute inset-0 rounded-3xl bg-linear-to-br from-primary/20 to-orange-100"></div> -->
			<div class="relative inset-4 flex flex-col items-center justify-center gap-3 rounded-2xl border border-border/60 bg-white/60 shadow-xl backdrop-blur">
				{ imageLabel === "Rak Gondola" ? (
					<Image src={produkImages[1].src} alt={imageLabel} width={produkImages[1].width} height={produkImages[1].height} class="w-full object-contain rounded-2xl text-primary/70" />
				) : (
					<Image src={produkImages[0].src} alt={imageLabel} width={produkImages[0].width} height={produkImages[0].height} class="w-full object-contain rounded-2xl text-primary/70" />
				)}
				<!-- <Image src={produkImages[0].src} alt={imageLabel} width={produkImages[0].width} height={produkImages[0].height} class="w-full object-contain rounded-2xl text-primary/70" /> -->
				<span class="text-sm font-medium text-muted-foreground">{imageLabel}</span>
			</div>
		</div>

		<div>
			<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
				{eyebrow}
			</span>
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				{title}
			</h2>
			<p class="mt-3 text-muted-foreground">{description}</p>

			<ul class="mt-6 space-y-3">
				{features.map((feature) => (
					<li class="flex items-start gap-3 text-sm text-foreground">
						<span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">
							✓
						</span>
						<span>{feature}</span>
					</li>
				))}
			</ul>

			{href && (
				<div class="mt-8">
					<a
						href={href}
						class={buttonVariants({ size: "lg" })}
					>
						{ctaLabel}
					</a>
				</div>
			)}
		</div>
	</div>
</section>
