---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCatalogFlipbook from "@/components/ProductCatalogFlipbook";
import { buttonVariants } from "@/components/ui/button";
import { WA_LINK } from "@/lib/constants";
---

<BaseLayout title="Katalog Digital">
	<section class="bg-neutral-950">
		<div class="mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 lg:px-8">
			<div class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
				<div>
					<span class="inline-flex items-center rounded-full border border-primary/40 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-orange-400">
						Katalog Digital
					</span>
					<h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
						Katalog Produk Media Jaya Rak
					</h1>
					<p class="mt-3 max-w-2xl text-base text-white/60 sm:text-lg">
						Buka katalog seperti majalah digital — klik ujung halaman, gunakan
						kontrol di bawah, atau buka langsung lewat tautan #page/N.
					</p>
				</div>
				<a
					href={WA_LINK}
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ size: "lg" })}
				>
					Tanya Produk via WhatsApp
				</a>
			</div>

			<ProductCatalogFlipbook client:load />
		</div>
	</section>
</BaseLayout>
