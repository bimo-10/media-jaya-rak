<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Media Jaya Rak — Distributor Rak Minimarket &amp; Peralatan Toko</title>
<meta name="description" content="Media Jaya Rak menjual rak minimarket, rak single, rak double, rak heavy duty, meja kasir, keranjang belanja, dan peralatan toko berkualitas dengan harga terjangkau.">
<link rel="icon" type="image/webp" href="assets/logo.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --orange-50:#fff7ed;
  --orange-100:#ffedd5;
  --orange-200:#fed7aa;
  --orange-300:#fdba74;
  --orange-400:#fb923c;
  --orange-500:#f97316;
  --orange-600:#ea580c;
  --orange-700:#c2410c;
  --orange-800:#9a3412;
  --orange-900:#7c2d12;
  --dark:#1f2937;
  --dark-900:#111827;
  --gray:#6b7280;
  --light:#f9fafb;
  --white:#ffffff;
  --grad:linear-gradient(135deg,#f97316 0%,#ea580c 55%,#c2410c 100%);
  --radius:16px;
  --shadow:0 10px 30px rgba(234,88,12,.15);
  --shadow-lg:0 20px 50px rgba(194,65,12,.25);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;color:var(--dark);background:var(--white);line-height:1.6;overflow-x:hidden}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
ul{list-style:none}
.container{width:min(1180px,92%);margin-inline:auto}
section{padding:88px 0}
.sec-head{text-align:center;max-width:680px;margin:0 auto 48px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--orange-100);color:var(--orange-700);font-weight:700;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;padding:8px 18px;border-radius:999px;margin-bottom:16px}
.sec-title{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;line-height:1.2;color:var(--dark-900)}
.sec-title span{color:var(--orange-600)}
.sec-sub{color:var(--gray);margin-top:14px;font-size:1.05rem}

/* ---------- TOP BAR ---------- */
.topbar{background:var(--dark-900);color:#fff;font-size:.85rem;padding:9px 0}
.topbar .container{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.topbar a{color:var(--orange-300);font-weight:600;transition:.2s}
.topbar a:hover{color:#fff}
.topbar .right{display:flex;gap:18px;align-items:center}
.topbar .right span{display:inline-flex;align-items:center;gap:6px}

/* ---------- NAVBAR ---------- */
.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);box-shadow:0 2px 20px rgba(17,24,39,.06)}
.nav .container{display:flex;align-items:center;justify-content:space-between;height:76px}
.brand{display:flex;align-items:center;gap:12px}
.brand img{height:46px;width:auto;object-fit:contain}
.brand-name{font-weight:800;font-size:1.25rem;line-height:1.1;color:var(--dark-900)}
.brand-name span{color:var(--orange-600)}
.brand-tag{display:block;font-size:.68rem;font-weight:600;color:var(--gray);letter-spacing:.08em;text-transform:uppercase}
.nav-links{display:flex;align-items:center;gap:28px}
.nav-links a{font-weight:600;font-size:.95rem;color:var(--dark);transition:.2s}
.nav-links a:hover{color:var(--orange-600)}
.nav-cta{background:var(--grad);color:#fff;padding:11px 22px;border-radius:999px;font-weight:700;font-size:.92rem;box-shadow:var(--shadow);transition:.25s;display:inline-flex;align-items:center;gap:8px}
.nav-cta:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:6px}
.burger span{width:26px;height:3px;background:var(--dark-900);border-radius:3px;transition:.3s}

/* ---------- HERO ---------- */
.hero{position:relative;background:var(--grad);color:#fff;padding:0;overflow:hidden}
.hero::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,.18),transparent 45%)}
.hero .container{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:48px;padding-block:72px;position:relative;z-index:1}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);padding:8px 16px;border-radius:999px;font-size:.82rem;font-weight:600;margin-bottom:20px;backdrop-filter:blur(4px)}
.hero h1{font-size:clamp(2.1rem,5vw,3.4rem);font-weight:800;line-height:1.12;margin-bottom:20px}
.hero h1 em{font-style:normal;color:#ffe0c2}
.hero p{font-size:1.1rem;opacity:.95;max-width:520px;margin-bottom:32px}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 30px;border-radius:999px;font-weight:700;font-size:1rem;transition:.25s;border:0;cursor:pointer}
.btn-white{background:#fff;color:var(--orange-700);box-shadow:0 8px 25px rgba(0,0,0,.18)}
.btn-white:hover{transform:translateY(-3px)}
.btn-outline{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.6)}
.btn-outline:hover{background:rgba(255,255,255,.12);transform:translateY(-3px)}
.hero-feats{display:flex;gap:28px;margin-top:36px;flex-wrap:wrap}
.hero-feats div{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.95rem}
.hero-feats svg{width:22px;height:22px;flex-shrink:0}
.hero-visual{position:relative}
.hero-visual .banner{border-radius:24px;box-shadow:0 30px 70px rgba(0,0,0,.35);border:6px solid rgba(255,255,255,.25)}
.float-card{position:absolute;background:#fff;border-radius:14px;padding:12px 18px;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:12px;animation:float 4s ease-in-out infinite}
.float-card .ic{width:42px;height:42px;border-radius:12px;background:var(--orange-100);display:grid;place-items:center}
.float-card .ic svg{width:22px;height:22px;color:var(--orange-600)}
.float-card b{display:block;font-size:.9rem;color:var(--dark-900)}
.float-card small{color:var(--gray);font-size:.78rem}
.fc-1{top:-18px;left:-24px}
.fc-2{bottom:-18px;right:-14px;animation-delay:1.5s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

/* ---------- STRIP ---------- */
.strip{background:var(--dark-900);color:#fff;padding:22px 0}
.strip .container{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.strip div{display:flex;align-items:center;gap:14px;justify-content:center;padding:8px}
.strip .ic{width:46px;height:46px;border-radius:12px;background:var(--orange-500);display:grid;place-items:center;flex-shrink:0}
.strip .ic svg{width:24px;height:24px}
.strip b{display:block;font-size:1.05rem}
.strip small{color:var(--orange-200);font-size:.8rem}

/* ---------- PRODUCTS ---------- */
.products{background:var(--orange-50)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.card{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:0 4px 18px rgba(17,24,39,.06);transition:.3s;display:flex;flex-direction:column;border:1px solid var(--orange-100)}
.card:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
.card-img{aspect-ratio:1/1;overflow:hidden;background:var(--orange-100);position:relative}
.card-img img{width:100%;height:100%;object-fit:cover;transition:.5s}
.card:hover .card-img img{transform:scale(1.08)}
.card-tag{position:absolute;top:14px;left:14px;background:var(--orange-600);color:#fff;font-size:.72rem;font-weight:700;padding:6px 12px;border-radius:999px;letter-spacing:.04em}
.card-body{padding:20px;display:flex;flex-direction:column;gap:8px;flex:1}
.card-body h3{font-size:1.05rem;font-weight:700;color:var(--dark-900)}
.card-body p{font-size:.88rem;color:var(--gray);flex:1}
.card-link{display:inline-flex;align-items:center;gap:8px;color:var(--orange-600);font-weight:700;font-size:.9rem;transition:.2s}
.card-link:hover{gap:12px;color:var(--orange-800)}
.catalog-cta{text-align:center;margin-top:48px}
.btn-dark{background:var(--grad);color:#fff;box-shadow:var(--shadow)}
.btn-dark:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}

/* ---------- SECTION BANNER ---------- */
.banner-cta{position:relative;padding:0}
.banner-cta img{width:100%;height:auto;object-fit:cover}
.banner-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(124,45,18,.75),rgba(234,88,12,.35));display:flex;align-items:center}
.banner-overlay .container{width:100%}
.banner-overlay h2{color:#fff;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;max-width:600px;line-height:1.15;margin-bottom:22px}
.banner-overlay .btn{margin-top:6px}

/* ---------- WHY ---------- */
.why{background:var(--white)}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.why-card{background:var(--light);border:1px solid var(--orange-100);border-radius:var(--radius);padding:32px 28px;transition:.3s}
.why-card:hover{background:#fff;box-shadow:var(--shadow);transform:translateY(-6px)}
.why-card .ic{width:56px;height:56px;border-radius:14px;background:var(--grad);display:grid;place-items:center;margin-bottom:20px;box-shadow:var(--shadow)}
.why-card .ic svg{width:26px;height:26px;color:#fff}
.why-card h3{font-size:1.15rem;font-weight:700;margin-bottom:10px;color:var(--dark-900)}
.why-card p{color:var(--gray);font-size:.95rem}

/* ---------- CONTACT / CTA ---------- */
.contact{background:var(--grad);color:#fff;position:relative;overflow:hidden}
.contact::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 90% 10%,rgba(255,255,255,.2),transparent 40%)}
.contact .container{position:relative;text-align:center}
.contact h2{font-size:clamp(1.9rem,4.5vw,3rem);font-weight:800;margin-bottom:16px}
.contact p{max-width:560px;margin:0 auto 36px;font-size:1.1rem;opacity:.95}
.contact-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn-wa{background:#25d366;color:#fff;box-shadow:0 10px 30px rgba(37,211,102,.35)}
.btn-wa:hover{transform:translateY(-3px)}
.btn-white-big{background:#fff;color:var(--orange-700);box-shadow:0 10px 30px rgba(0,0,0,.2)}
.btn-white-big:hover{transform:translateY(-3px)}

/* ---------- FOOTER ---------- */
footer{background:var(--dark-900);color:#cbd5e1;padding:64px 0 0;font-size:.95rem}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:48px}
.footer-brand{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.footer-brand img{height:44px;width:auto}
.footer-brand b{font-size:1.2rem;color:#fff;font-weight:800}
.footer-brand b span{color:var(--orange-400)}
footer p.desc{color:#94a3b8;max-width:320px;line-height:1.7}
footer h4{color:#fff;font-size:1rem;font-weight:700;margin-bottom:18px}
footer ul li{margin-bottom:12px}
footer ul a{color:#94a3b8;transition:.2s}
footer ul a:hover{color:var(--orange-400)}
footer .socials{display:flex;gap:12px;margin-top:20px}
footer .socials a{width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.08);display:grid;place-items:center;transition:.25s}
footer .socials a:hover{background:var(--orange-500);transform:translateY(-3px)}
footer .socials img{width:20px;height:20px}
.wa-list{display:flex;flex-direction:column;gap:12px}
.wa-list a{display:inline-flex;align-items:center;gap:10px;color:#94a3b8;transition:.2s}
.wa-list a:hover{color:var(--orange-400)}
.wa-list img{width:20px;height:20px}
.copyright{border-top:1px solid rgba(255,255,255,.1);padding:20px 0;text-align:center;color:#64748b;font-size:.85rem}

/* ---------- FLOAT WA ---------- */
.float-wa{position:fixed;bottom:26px;right:26px;z-index:60;width:62px;height:62px;border-radius:50%;background:#25d366;display:grid;place-items:center;box-shadow:0 12px 30px rgba(37,211,102,.45);transition:.25s;animation:float 4s ease-in-out infinite}
.float-wa:hover{transform:scale(1.1)}
.float-wa img{width:32px;height:32px}
.float-wa::after{content:"";position:absolute;inset:0;border-radius:50%;border:3px solid rgba(37,211,102,.6);animation:ping 1.8s ease-out infinite}
@keyframes ping{0%{transform:scale(1);opacity:1}100%{transform:scale(1.6);opacity:0}}

/* ---------- MOBILE ---------- */
@media(max-width:1024px){
  .grid{grid-template-columns:repeat(3,1fr)}
  .why-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:860px){
  .hero .container{grid-template-columns:1fr;padding-block:56px;text-align:center}
  .hero p{margin-inline:auto}
  .hero-ctas,.hero-feats{justify-content:center}
  .hero-visual{order:-1;max-width:520px;margin-inline:auto}
  .fc-1{left:0}
  .fc-2{right:0}
  .strip .container{grid-template-columns:repeat(2,1fr);gap:8px}
  .footer-grid{grid-template-columns:1fr 1fr}
  .nav-links{position:fixed;top:0;right:-100%;height:100vh;width:min(320px,80vw);background:#fff;flex-direction:column;align-items:flex-start;padding:96px 36px;gap:26px;box-shadow:-20px 0 60px rgba(0,0,0,.2);transition:right .35s ease;z-index:55}
  .nav-links.open{right:0}
  .burger{display:flex;z-index:60}
  .nav-cta{margin-top:8px}
}
@media(max-width:620px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .why-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr;gap:32px}
  .topbar .right span:first-child{display:none}
  .topbar .container{justify-content:center}
  .strip .container{grid-template-columns:1fr 1fr}
}
</style>
</head>
