---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import { buttonVariants } from "@/components/ui/button";
import { WA_LINK } from "@/lib/constants";
import { getProdukImage } from "@/lib/produkImages";
import { Image } from "astro:assets";
import { LayoutGrid, ShoppingCart } from "lucide-react";

console.log("Produk Images:", await Promise.all([...Array(30).keys()].map((i) => getProdukImage(i).then((img) => ({ index: i , alt: img.alt })))));
const productImages = await Promise.all([22, 23, 24, 25, 7, 26, 27, 9, 28, 10, 29, 6].map(getProdukImage));
console.log("Produk Lainnya Images:", productImages.map((img, index) => ({ index, alt: img.alt })));

const products = [
	{ name: "Backmesh Dinding", image: productImages[0] },
	{ name: "Backmesh Kaki", image: productImages[1] },
	{ name: "Box Wagon", image: productImages[2] },
	{ name: "Double Ram", image: productImages[3] },
	{ name: "Keranjang Mirani", image: productImages[4] },
	{ name: "Keranjang Tarik", image: productImages[5] },
	{ name: "Pintu Masuk Putar", image: productImages[6] },
	{ name: "Pricecard", image: productImages[7] },
	{ name: "Rak Snack Keranjang", image: productImages[8] },
	{ name: "Single Chrome Ram", image: productImages[9] },
	{ name: "Stopper", image: productImages[10] },
	{ name: "Trolly Belanja", image: productImages[11] }
];
---

<BaseLayout title="Produk Lainnya">
	<section class="relative overflow-hidden bg-linear-to-b from-orange-50 via-white to-white">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
			<nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
				<ol class="flex flex-wrap items-center gap-1.5">
					<li>
						<a href="/" class="transition-colors hover:text-primary">Home</a>
					</li>
					<li aria-hidden="true">/</li>
					<li>
						<a href="/produk-kami" class="transition-colors hover:text-primary">Produk Kami</a>
					</li>
					<li aria-hidden="true">/</li>
					<li class="font-medium text-foreground">Produk Lainnya</li>
				</ol>
			</nav>

			<div class="mx-auto max-w-3xl text-center">
				<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
					PERLENGKAPAN TOKO &amp; DISPLAY
				</span>
				<h1 class="mt-5 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl">
					Produk Lainnya
				</h1>
				<p class="mx-auto mt-5 max-w-2xl text-base text-muted-foreground sm:text-lg">
					Selain rak gondola dan rak gudang, kami juga menyediakan berbagai
					perlengkapan toko dan display pendukung untuk melengkapi kebutuhan bisnis Anda.
				</p>
				<div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
					<a
						href={WA_LINK}
						target="_blank"
						rel="noopener noreferrer"
						class={buttonVariants({ size: "lg" })}
					>
						Konsultasi & Order via WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-primary/5 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
					KATALOG PRODUK
				</span>
				<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					Perlengkapan Toko &amp; Display Lainnya
				</h2>
				<p class="mt-3 text-muted-foreground">
					Pilih produk yang Anda butuhkan, lalu tanyakan harga dan ketersediaannya.
				</p>
			</div>

			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{products.map(({ name, image }) => (
					<figure class="group overflow-hidden rounded-xl border border-border/70 bg-white shadow-sm transition-shadow hover:shadow-md">
						<div class="flex aspect-4/3 items-center justify-center bg-linear-to-br from-orange-50 to-secondary">
							<Image
								src={image.src}
								alt={image.alt}
								width={image.width}
								height={image.height}
								loading="lazy"
								class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
							/>
						</div>
						<figcaption class="flex items-center justify-between gap-3 border-t border-border/70 p-4">
							<h3 class="font-semibold text-foreground">{name}</h3>
							<a
								href={WA_LINK}
								target="_blank"
								rel="noopener noreferrer"
								class={buttonVariants({ size: "sm", variant: "default" })}
							>
								Tanya Harga
							</a>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<section class="bg-secondary/40 py-16">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-6 sm:grid-cols-2">
				<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<LayoutGrid className="size-5" strokeWidth={1.75} />
					</span>
					<h3 class="mt-4 font-semibold text-foreground">Butuh Rak Gondola?</h3>
					<p class="mt-2 text-sm text-muted-foreground">
						Lihat detail rak gondola premium untuk toko retail dan minimarket Anda.
					</p>
					<a
						href="/produk-kami/rak-gondola"
						class={`mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/80`}
					>
						Lihat Rak Gondola →
					</a>
				</div>
				<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<ShoppingCart className="size-5" strokeWidth={1.75} />
					</span>
					<h3 class="mt-4 font-semibold text-foreground">Butuh Rak Gudang?</h3>
					<p class="mt-2 text-sm text-muted-foreground">
						Lihat detail rak gudang heavy duty untuk penyimpanan berat dan efisien.
					</p>
					<a
						href="/produk-kami/rak-gudang"
						class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary/80"
					>
						Lihat Rak Gudang →
					</a>
				</div>
			</div>
		</div>
	</section>

	<CtaSection
		title="Butuh Perlengkapan Toko Lainnya?"
		description="Tanyakan produk apa pun yang Anda butuhkan. Tim kami siap membantu memilihkan yang paling sesuai untuk toko dan gudang Anda."
		ctaLabel="Chat via WhatsApp Sekarang"
	/>
</BaseLayout>
