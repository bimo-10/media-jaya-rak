---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import { buttonVariants } from "@/components/ui/button";
import { WA_LINK } from "@/lib/constants";
import { getProdukImage } from "@/lib/produkImages";
import { Image } from "astro:assets";
import {
	LayoutGrid,
	Settings2,
	Ruler,
	Weight,
	Package,
	ShieldCheck,
	Palette,
	Wrench,
	Tags,
	Layers,
	CheckCircle2,
} from "lucide-react";

// console.log semua getProdukImage untuk memastikan semua gambar berhasil diambil
console.log("Gambar Rak Gondola:", await Promise.all([...Array(21).keys()].map((i) => getProdukImage(i).then((img) => ({ index: i, alt: img.alt })))));
const heroImage = await getProdukImage(3);
const detailImage = await getProdukImage(0);
const galleryImages = await Promise.all([0, 1, 3, 20, 21, 16, 17, 19,18].map(getProdukImage));
console.log("Gallery Images:", galleryImages.map((img, index) => ({ index, alt: img.alt })));

const gallery = [
	{ name: "Rak Meja Kasir Alfa Sudut", image: galleryImages[3] },
	{ name: "Rak Meja Kasir Alfa Standar", image: galleryImages[4] },
	{ name: "Rak Backpanel Perforated", image: galleryImages[5] },
	{ name: "Rak Backpanel Polos", image: galleryImages[6] },
	{ name: "Rak Corner", image: galleryImages[8] },
	{ name: "Rak Gondola Double Sided", image: galleryImages[0] },
	{ name: "Rak End", image: galleryImages[7] },
	{ name: "Rak Gondola Single Sided", image: galleryImages[1] },
];

const variants = [
	{
		title: "Rak Gondola Single Sided",
		description:
			"Rak satu sisi ideal untuk ditempel di dinding toko atau pembatas area. Cocok untuk minimarket, toko kelontong, dan apotek.",
		Icon: LayoutGrid,
	},
	{
		title: "Rak Gondola Double Sided",
		description:
			"Rak dua sisi yang bisa diakses pelanggan dari kanan dan kiri. Paling efektif untuk tata letak lorong (aisle) minimarket dan swalayan.",
		Icon: Layers,
	},
	{
		title: "End Cap Gondola",
		description:
			"Rak ujung lorong yang strategis untuk display produk promo, impulsif, dan barang unggulan agar lebih mudah terlihat.",
		Icon: Package,
	},
];

const specs = [
	{ label: "Bahan Utama", value: "Besi hollow tebal + finishing powder coating", Icon: Settings2 },
	{ label: "Kapasitas Beban", value: "Hingga 50 kg per susun", Icon: Weight },
	{ label: "Dimensi Standar", value: "Panjang 90–120 cm, Tinggi 120–200 cm", Icon: Ruler },
	{ label: "Penyesuaian Shelf", value: "Adjustable — ketinggian bisa diatur", Icon: Layers },
	{ label: "Tahan Karat", value: "Lapisan anti karat, aman di ruangan lembab", Icon: ShieldCheck },
	{ label: "Warna Tersedia", value: "Putih, Merah, Biru, dan warna custom", Icon: Palette },
	{ label: "Pemasangan", value: "Modular, mudah bongkar pasang", Icon: Wrench },
	{ label: "Harga", value: "Bersahabat, negosiasi untuk pembelian banyak", Icon: Tags },
];

const accessories = [
	"Front Fence / pengaman rak depan",
	"Price Tag Holder / label harga",
	"Divider / pembatas produk",
	"End Cap / rak ujung lorong",
	"Topper / rak display di atas",
	"Base deck / alas lantai tambahan",
];
---

<BaseLayout title="Rak Gondola">
	<section class="relative overflow-hidden bg-linear-to-b from-orange-50 via-white to-white">
		<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24 lg:px-8">
			<nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
				<ol class="flex flex-wrap items-center gap-1.5">
					<li>
						<a href="/" class="transition-colors hover:text-primary">Home</a>
					</li>
					<li aria-hidden="true">/</li>
					<li>
						<a href="/produk-kami" class="transition-colors hover:text-primary">Produk Kami</a>
					</li>
					<li aria-hidden="true">/</li>
					<li class="font-medium text-foreground">Rak Gondola</li>
				</ol>
			</nav>

			<div class="grid items-center gap-10 lg:grid-cols-2">
				<div>
					<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
						RAK RETAIL &amp; MINIMARKET
					</span>
					<h1 class="mt-5 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl md:text-5xl">
						Rak Gondola Premium
					</h1>
					<p class="mt-5 max-w-xl text-base text-muted-foreground sm:text-lg">
						Rak gondola adalah andalan toko retail, minimarket, apotek, hingga
						swalayan. Desain terbuka dari dua sisi bikin pelanggan gampang melihat,
						mengambil, dan berbelanja lebih nyaman.
					</p>
					<div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
						<a
							href={WA_LINK}
							target="_blank"
							rel="noopener noreferrer"
							class={buttonVariants({ size: "lg" })}
						>
							Konsultasi & Order via WhatsApp
						</a>
						<a href="#spesifikasi" class={buttonVariants({ size: "lg", variant: "outline" })}>
							Lihat Spesifikasi
						</a>
					</div>
					<div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
						<span class="rounded-full border border-border bg-white px-4 py-1.5 text-xs font-semibold text-foreground shadow-sm">
							Adjustable Shelf
						</span>
						<span class="rounded-full border border-border bg-white px-4 py-1.5 text-xs font-semibold text-foreground shadow-sm">
							Anti Karat
						</span>
						<span class="rounded-full border border-border bg-white px-4 py-1.5 text-xs font-semibold text-foreground shadow-sm">
							Garansi Konstruksi
						</span>
					</div>
				</div>

				<div class="flex justify-center">
					<div class="overflow-hidden rounded-3xl border border-border/60 bg-white shadow-xl">
						<Image
							src={heroImage.src}
							alt={heroImage.alt}
							width={heroImage.width}
							height={heroImage.height}
							class="h-full w-full object-contain"
						/>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="spesifikasi" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
				VARIANT RAK GONDOLA
			</span>
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				Pilih Tipe yang Sesuai Kebutuhan Toko Anda
			</h2>
			<p class="mt-3 text-muted-foreground">
				Setiap tipe bisa disesuaikan ukuran, warna, dan aksesorisnya.
			</p>
		</div>

		<div class="mt-10 grid gap-6 md:grid-cols-3">
			{variants.map(({ title, description, Icon }) => (
				<div class="rounded-xl border border-border/70 bg-white p-6 shadow-sm">
					<span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<Icon className="size-5" strokeWidth={1.75} />
					</span>
					<h3 class="mt-4 font-semibold text-foreground">{title}</h3>
					<p class="mt-2 text-sm text-muted-foreground">{description}</p>
				</div>
			))}
		</div>
	</section>

	<section class="bg-primary/5 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
					GALERI PRODUK
				</span>
				<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					Gambar Produk Rak Gondola
				</h2>
				<p class="mt-3 text-muted-foreground">
					Berbagai varian rak gondola yang siap kami kirim untuk kebutuhan toko Anda.
				</p>
			</div>

			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{gallery.map(({ name, image }) => (
					<figure class="group overflow-hidden rounded-xl border border-border/70 bg-white shadow-sm transition-shadow hover:shadow-md">
						<div class="flex aspect-4/3 items-center justify-center bg-linear-to-br from-orange-50 to-secondary">
							<Image
								src={image.src}
								alt={image.alt}
								width={image.width}
								height={image.height}
								loading="lazy"
								class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
							/>
						</div>
						<figcaption class="border-t border-border/70 p-4 text-center text-sm font-semibold text-foreground">
							{name}
						</figcaption>
					</figure>
				))}
			</div>

			<div class="mt-10 text-center">
				<a
					href={WA_LINK}
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ size: "lg" })}
				>
					Minta Foto & Harga Lengkap
				</a>
			</div>
		</div>
	</section>

	<section class="bg-secondary/40 py-16">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
			<div class="order-2 lg:order-1">
				<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
					SPESIFIKASI
				</span>
				<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					Material Tebal, Kokoh, dan Tahan Lama
				</h2>
				<p class="mt-3 text-muted-foreground">
					Rak gondola kami diproduksi dengan material berkualitas sehingga tetap
					kokoh meski menampilkan produk dalam jumlah banyak setiap hari.
				</p>

				<ul class="mt-6 grid gap-3 sm:grid-cols-2">
					{specs.map(({ label, value, Icon }) => (
						<li class="flex items-start gap-3 rounded-xl border border-border/70 bg-white p-4 shadow-sm">
							<span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
								<Icon className="size-4" strokeWidth={1.75} />
							</span>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{label}</p>
								<p class="mt-0.5 text-sm font-medium text-foreground">{value}</p>
							</div>
						</li>
					))}
				</ul>
			</div>

			<div class="order-1 flex justify-center lg:order-2">
				<div class="overflow-hidden rounded-3xl border border-border/60 bg-white shadow-xl">
					<Image
						src={detailImage.src}
						alt={detailImage.alt}
						width={detailImage.width}
						height={detailImage.height}
						class="h-full w-full object-contain"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-4 py-1 text-xs font-semibold tracking-wide text-primary">
				AKSESORIS
			</span>
			<h2 class="mt-4 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				Lengkapi dengan Aksesoris Pendukung
			</h2>
			<p class="mt-3 text-muted-foreground">
				Tambahkan aksesoris untuk tampilan lebih rapi dan display produk yang lebih menarik.
			</p>
		</div>

		<div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{accessories.map((accessory) => (
				<div class="flex items-start gap-3 rounded-xl border border-border/70 bg-white p-4 shadow-sm">
					<CheckCircle2 className="mt-0.5 size-5 shrink-0 text-primary" />
					<span class="text-sm font-medium text-foreground">{accessory}</span>
				</div>
			))}
		</div>

		<div class="mt-10 text-center">
			<a
				href={WA_LINK}
				target="_blank"
				rel="noopener noreferrer"
				class={buttonVariants({ size: "lg" })}
			>
				Tanya Ketersediaan Aksesoris
			</a>
		</div>
	</section>

	<CtaSection
		title="Siap Menata Toko dengan Rak Gondola?"
		description="Konsultasikan kebutuhan rak gondola Anda bersama tim kami. Gratis, tanpa tekanan, dan langsung dapat penawaran terbaik."
		ctaLabel="Chat via WhatsApp Sekarang"
	/>
</BaseLayout>
